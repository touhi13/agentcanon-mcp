{
  "name": "agentcanon-mcp",
  "version": "0.1.0",
  "description": "Single source of truth MCP server and CLI for AI coding instructions across OpenAI Codex (AGENTS.md), Cursor (.mdc), Claude Code (CLAUDE.md), and GitHub Copilot with approval-bound synchronization.",
  "author": "touhi13",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/touhi13/agentcanon-mcp.git"
  },
  "homepage": "https://github.com/touhi13/agentcanon-mcp#readme",
  "bugs": {
    "url": "https://github.com/touhi13/agentcanon-mcp/issues"
  },
  "bin": {
    "agentcanon-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "SPEC.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dogfood": "node dist/index.js --init && node dist/index.js --sync-yes",
    "check:drift": "node dist/index.js --check"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "openai-codex",
    "agents-md",
    "cursor-rules",
    "claude-code",
    "copilot-instructions",
    "ai-coding-agents",
    "agentcanon"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
